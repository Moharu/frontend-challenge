# Configuração pública definida no build; nunca incluir segredos.
# Na Vercel nenhuma variável é necessária: estes já são os padrões.
# Base da API (as chamadas são atendidas pelo service worker do MSW).
VITE_API_BASE_URL=/api
# Mocks habilitados: a demonstração não tem backend real.
VITE_ENABLE_MOCKS=true
# VITE_ENABLE_TEST_HARNESS pertence só ao modo integration; nunca na Vercel.
